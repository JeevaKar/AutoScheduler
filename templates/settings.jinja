{% extends "base.jinja" %}

{% block title %}Settings{% endblock %}

{% block bodyClass %}form-page{% endblock %}

{% block body %}

<div class="formDiv">
	<h2>Settings</h2>
	<form method="post" class="form">
	    <label for="worktime">Work Block Length (minutes)</label>
	    <input name="worktime" id="worktime" value="{{ worktime }}" required>

	    <label for="breaktime">Break Block Length (minutes)</label>
	    <input name="breaktime" id="breaktime" value="{{ breaktime }}" required>

	    <input type="submit" id="submit" value="Save Changes">
	</form>
</div>

{% endblock %}