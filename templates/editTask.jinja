{% extends 'base.jinja' %}

{% block title %}Edit Task{% endblock %}

{% block bodyClass %}form-page{% endblock %}

{% block body %}
<div class="formDiv">
	<form class="form" method="POST">
		<h2>Edit Task:</h2>
		<label for="title">Title:</label>
		<input type="text" name="title" id="title" value="{{ task.title }}">
		<label for="dueDate">Due Date:</label>
		<input type="date" name="dueDate" id="dueDate" value="{{ task.dueDate }}">
		<label for="dueTime">Due Time:</label>
		<input type="time" name="dueTime" id="dueTime" value="{{ task.dueTime }}">
		<label for="completionTime">Estimated Completion Time (minutes):</label>
		<input type="number" name="completionTime" id="completionTime" value="{{ task.completionTime }}">
		<button type="submit">Save Task</button>
	</form>
</div>
{% endblock %}